{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/pnpm-lock.yaml", "{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/eslint.config.mjs", "{workspaceRoot}/vitest.config.ts", "{workspaceRoot}/.node-version", "{workspaceRoot}/contracts/**/*"],
    "production": ["default", "!{projectRoot}/**/*.test.*"]
  },
  "targetDefaults": {
    "lint": { "cache": true, "inputs": ["default", "^default"] },
    "typecheck": { "cache": true, "inputs": ["default", "^default"], "dependsOn": ["^build"] },
    "test": { "cache": true, "inputs": ["default", "^default"], "dependsOn": ["^build"] },
    "build": { "cache": true, "inputs": ["production", "^production"], "dependsOn": ["^build"] },
    "serve": { "cache": false, "continuous": true, "dependsOn": ["^build"] }
  },
  "analytics": false
}
