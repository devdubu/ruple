{
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "tags": [
    "type:app",
    "scope:web",
    "env:browser"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/web"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/web/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run apps/web"
      }
    },
    "build": {
      "inputs": ["production", "^production", "{workspaceRoot}/assets/branding/**/*"],
      "executor": "nx:run-commands",
      "options": {
        "command": "vite build --config apps/web/vite.config.ts"
      },
      "outputs": [
        "{workspaceRoot}/dist/apps/web"
      ]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --config apps/web/vite.config.ts"
      }
    }
  }
}
