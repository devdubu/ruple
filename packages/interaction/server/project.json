{
  "name": "interaction-server",
  "projectType": "library",
  "sourceRoot": "packages/interaction/server/src",
  "tags": [
    "type:lib",
    "scope:interaction",
    "scope:interaction-internal",
    "env:server"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/interaction/server"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/interaction/server/tsconfig.json --noEmit"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/interaction/server/tsconfig.build.json"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    }
  }
}
