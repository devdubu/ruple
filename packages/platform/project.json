{
  "name": "platform",
  "projectType": "library",
  "sourceRoot": "packages/platform/src",
  "tags": [
    "type:lib",
    "scope:shared",
    "env:universal"
  ],
  "targets": {
    "test": { "executor": "nx:run-commands", "options": { "command": "vitest run packages/platform" } },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/platform"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/platform/tsconfig.json --noEmit"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/platform/tsconfig.json --noEmit"
      }
    }
  }
}
