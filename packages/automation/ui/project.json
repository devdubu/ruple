{
  "name": "automation-ui",
  "projectType": "library",
  "sourceRoot": "packages/automation/ui/src",
  "tags": [
    "type:lib",
    "scope:automation",
    "scope:automation-internal",
    "env:browser"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/automation/ui"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/automation/ui/tsconfig.json --noEmit"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/automation/ui/tsconfig.json --noEmit"
      }
    }
  }
}
