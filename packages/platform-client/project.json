{
  "name": "platform-client",
  "projectType": "library",
  "sourceRoot": "packages/platform-client/src",
  "tags": [
    "type:lib",
    "scope:shared",
    "env:browser"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/platform-client"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/platform-client/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run packages/platform-client"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/platform-client/tsconfig.json --noEmit"
      }
    }
  }
}
