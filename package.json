{
  "name": "@ruple/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev:ui": "cross-env VITE_UI_PREVIEW=true VITE_DEV_TRACK=all VITE_DEVICE_PROFILE=phone nx serve web --output-style=stream",
    "test:ui": "nx build web && playwright test --config apps/web/playwright.config.ts",
    "dev:a": "cross-env VITE_DEV_TRACK=a nx run-many -t serve -p web,context-api,ai-api --parallel=3 --outputStyle=stream",
    "dev:b": "cross-env VITE_DEV_TRACK=b nx run-many -t serve -p web,automation-api,automation-worker,interaction-api --parallel=4 --outputStyle=stream",
    "dev:all": "cross-env VITE_DEV_TRACK=all nx run-many -t serve -p web,context-api,ai-api,automation-api,automation-worker,interaction-api --parallel=6 --outputStyle=stream",
    "check": "nx run-many -t lint typecheck test build && node harness/check.mjs && node harness/contracts.mjs && node --test harness/tests/*.test.mjs && node --test tools/development/*.test.mjs",
    "check:contracts": "node harness/contracts.mjs",
    "contract:new": "node harness/contract-drafts.mjs new",
    "contract:check": "node harness/contract-drafts.mjs check",
    "check:boundaries": "node --test harness/tests/*.test.mjs",
    "test:smoke": "python3 scripts/smoke_workspace.py",
    "test:prototype": "python3 -m unittest discover -s prototypes/pleos-nav-probe/tests -v",
    "dev:isolated:a": "node tools/development/cli.mjs dev a",
    "dev:isolated:b": "node tools/development/cli.mjs dev b",
    "env:prepare": "node tools/development/cli.mjs prepare",
    "db:up": "node tools/development/cli.mjs up",
    "db:down": "node tools/development/cli.mjs down",
    "db:migrate": "node tools/development/cli.mjs migrate",
    "db:generate": "node tools/development/cli.mjs generate",
    "db:seed": "node tools/development/cli.mjs seed",
    "db:verify": "node tools/development/cli.mjs verify",
    "db:reset": "node tools/development/cli.mjs reset",
    "mock:scenario": "node tools/development/cli.mjs scenario",
    "mock:serve": "node tools/development/cli.mjs mocks",
    "dev:clock": "node tools/development/cli.mjs clock",
    "test:development": "nx build platform-server && node --test tools/development/*.test.mjs",
    "test:dev-db": "nx run-many -t build -p context-server,automation-server,interaction-server && node --test tools/development/database.integration.mjs",
    "test:isolated": "python3 scripts/smoke_isolated.py"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nx/eslint-plugin": "24.0.2",
    "@playwright/test": "1.64.1",
    "@ruple/platform-server": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "eslint": "9.39.5",
    "jsdom": "30.1.3",
    "nx": "24.0.2",
    "pg": "8.23.1",
    "tailwindcss": "4.3.3",
    "tsc-watch": "7.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
